# Copy this to .env and fill in values before running

# Local dev DB (used when running outside Docker)
DATABASE_URL=postgresql://ats_user:ats_password@localhost:5432/ats_db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-hex-string

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-this-to-a-fernet-key

ENVIRONMENT=dev
